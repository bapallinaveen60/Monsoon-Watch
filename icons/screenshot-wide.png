<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="720" viewBox="0 0 1280 1280">
  <defs>
    <radialGradient id="bg" cx="50%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#0d1e3a"/>
      <stop offset="100%" stop-color="#080d18"/>
    </radialGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="rgba(56,189,248,0.2)"/>
      <stop offset="100%" stop-color="transparent"/>
    </radialGradient>
  </defs>

  <!-- Background -->
  <rect width="1280" height="1280" rx="230" fill="url(#bg)"/>

  <!-- Glow -->
  <circle cx="640" cy="640" r="576" fill="url(#glow)"/>

  <!-- Radar rings -->
  <circle cx="640" cy="640" r="282" fill="none" stroke="rgba(56,189,248,0.15)" stroke-width="10.24"/><circle cx="640" cy="640" r="486" fill="none" stroke="rgba(56,189,248,0.15)" stroke-width="10.24"/><circle cx="640" cy="640" r="691" fill="none" stroke="rgba(56,189,248,0.15)" stroke-width="10.24"/>

  <!-- Sweep wedge -->
  <path d="M640,640 L1254.4,640 A614.4,614.4 0 0,0 1172.0860080851592,332.80000000000007 Z"
    fill="rgba(56,189,248,0.18)"/>

  <!-- Sweep line -->
  <line x1="640" y1="640" x2="1254.4" y2="640"
    stroke="rgba(56,189,248,0.7)" stroke-width="15.36" stroke-linecap="round"/>

  <!-- Center dot -->
  <circle cx="640" cy="640" r="32" fill="#38bdf8"/>

  <!-- Text: MW -->
  <text x="640" y="666"
    font-family="Arial Black, sans-serif"
    font-size="358" font-weight="900"
    fill="#ffffff" text-anchor="middle"
    letter-spacing="-1">MW</text>

  <!-- Text: subtitle -->
  <text x="640" y="870"
    font-family="Arial, sans-serif"
    font-size="128" font-weight="400"
    fill="rgba(56,189,248,0.8)" text-anchor="middle"
    letter-spacing="2">MONSOON</text>
</svg>