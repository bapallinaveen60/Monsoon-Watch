<svg xmlns="http://www.w3.org/2000/svg" width="390" height="844" viewBox="0 0 390 390">
  <defs>
    <radialGradient id="bg" cx="50%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#0d1e3a"/>
      <stop offset="100%" stop-color="#080d18"/>
    </radialGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="rgba(56,189,248,0.2)"/>
      <stop offset="100%" stop-color="transparent"/>
    </radialGradient>
  </defs>

  <!-- Background -->
  <rect width="390" height="390" rx="70" fill="url(#bg)"/>

  <!-- Glow -->
  <circle cx="195" cy="195" r="175.5" fill="url(#glow)"/>

  <!-- Radar rings -->
  <circle cx="195" cy="195" r="86" fill="none" stroke="rgba(56,189,248,0.15)" stroke-width="3.12"/><circle cx="195" cy="195" r="148" fill="none" stroke="rgba(56,189,248,0.15)" stroke-width="3.12"/><circle cx="195" cy="195" r="211" fill="none" stroke="rgba(56,189,248,0.15)" stroke-width="3.12"/>

  <!-- Sweep wedge -->
  <path d="M195,195 L382.2,195 A187.2,187.2 0 0,0 357.11995558844694,101.40000000000002 Z"
    fill="rgba(56,189,248,0.18)"/>

  <!-- Sweep line -->
  <line x1="195" y1="195" x2="382.2" y2="195"
    stroke="rgba(56,189,248,0.7)" stroke-width="4.68" stroke-linecap="round"/>

  <!-- Center dot -->
  <circle cx="195" cy="195" r="9.75" fill="#38bdf8"/>

  <!-- Text: MW -->
  <text x="195" y="203"
    font-family="Arial Black, sans-serif"
    font-size="109" font-weight="900"
    fill="#ffffff" text-anchor="middle"
    letter-spacing="-1">MW</text>

  <!-- Text: subtitle -->
  <text x="195" y="265"
    font-family="Arial, sans-serif"
    font-size="39" font-weight="400"
    fill="rgba(56,189,248,0.8)" text-anchor="middle"
    letter-spacing="2">MONSOON</text>
</svg>